      "item": [
        {
          "name": "01 Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login admin 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const token = json.accessToken;",
                  "pm.expect(token).to.be.ok;",
                  "pm.collectionVariables.set('adminToken', token);",
                  "pm.environment.set('adminToken', token);",
                  "console.log('adminToken OK');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "02 Registrar Usuario USER",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString().slice(-6);",
                  "const username = 'usuario_' + suffix;",
                  "const email = username + '@test.com';",
                  "const password = 'secret123';",
                  "pm.collectionVariables.set('demoUsername', username);",
                  "pm.collectionVariables.set('demoEmail', email);",
                  "pm.collectionVariables.set('demoPassword', password);",
                  "pm.environment.set('demoUsername', username);",
                  "pm.environment.set('demoEmail', email);",
                  "pm.environment.set('demoPassword', password);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registro 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "const token = json.accessToken;",
                  "pm.expect(token).to.be.ok;",
                  "pm.collectionVariables.set('userToken', token);",
                  "pm.environment.set('userToken', token);",
                  "console.log('userToken OK para', pm.collectionVariables.get('demoUsername'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{demoUsername}}\",\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "03 Crear Espacio (ADMIN)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.collectionVariables.get('adminToken') || pm.environment.get('adminToken');",
                  "if (!token) { throw new Error('Falta adminToken. Ejecuta primero 01 Login Admin.'); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Espacio 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "const id = String(json.id);",
                  "pm.expect(id).to.not.equal('undefined');",
                  "pm.expect(id).to.not.equal('null');",
                  "pm.collectionVariables.set('espacioId', id);",
                  "pm.environment.set('espacioId', id);",
                  "console.log('espacioId =', id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Sala Innovación\",\n  \"tipo\": \"MEETING_ROOM\",\n  \"capacidad\": 10,\n  \"ubicacion\": \"Piso 3 - Ala Norte\",\n  \"tarifaHora\": 35.50,\n  \"activo\": true\n}"
            },
            "url": "{{baseUrl}}/api/espacios"
          }
        },
        {
          "name": "04 Listar Espacios (USER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Listado 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
