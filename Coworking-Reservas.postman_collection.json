          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/espacios"
          }
        },
        {
          "name": "05 Crear Reserva (USER)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const espacioId = pm.collectionVariables.get('espacioId') || pm.environment.get('espacioId');",
                  "const userToken = pm.collectionVariables.get('userToken') || pm.environment.get('userToken');",
                  "if (!userToken) { throw new Error('Falta userToken. Ejecuta 02 Registrar Usuario.'); }",
                  "if (!espacioId || espacioId === 'null') { throw new Error('Falta espacioId. Ejecuta 03 Crear Espacio.'); }",
                  "pm.collectionVariables.set('espacioId', String(espacioId));",
                  "pm.environment.set('espacioId', String(espacioId));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reserva 201 PENDING', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.estado).to.eql('PENDING');",
                  "  pm.expect(json.id).to.exist;",
                  "  const id = String(json.id);",
                  "  pm.collectionVariables.set('reservaId', id);",
                  "  pm.environment.set('reservaId', id);",
                  "  console.log('reservaId guardado =', id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"espacioId\": {{espacioId}},\n  \"inicio\": \"{{reservaInicio}}\",\n  \"fin\": \"{{reservaFin}}\"\n}"
            },
            "url": "{{baseUrl}}/api/reservas"
          }
        },
        {
          "name": "06 Confirmar Reserva (pago OK)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let id = pm.collectionVariables.get('reservaId') || pm.environment.get('reservaId');",
                  "if (!id || id === 'null' || id === 'undefined' || id === '') {",
                  "  throw new Error('reservaId está vacío/null. Ejecuta de nuevo el paso 05 y mira que el Test diga PASS y que el Body traiga \"id\".');",
                  "}",
                  "id = String(id);",
                  "pm.collectionVariables.set('reservaId', id);",
                  "pm.environment.set('reservaId', id);",
                  "console.log('Confirmando reservaId =', id);"
                ]
              }
            },
